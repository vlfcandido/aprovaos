# O que é: modelo do `.env` do AprovaOS (copie para `.env` e preencha). Quando ler: ao subir o
# projeto pela primeira vez ou ao acrescentar campo em `backend/aprovaos/config.py`.

# Banco (Compose local): usuário/senha/banco definidos em compose.yaml
DATABASE_URL=postgresql+psycopg://aprovaos:troque@localhost:5432/aprovaos
# Porta do Postgres no host (use outra se já houver Postgres local na 5432)
POSTGRES_PORT=5432
POSTGRES_PASSWORD=troque

# Segredo do cookie de sessão — gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
CHAVE_SECRETA=

# dev | teste | prod
AMBIENTE=dev

# Cookie `Secure` exige https. No piloto por http em rede local (ADR-0030), use false — ver docs/RISCOS.md.
COOKIE_SEGURO=true

# Validade da sessão em dias
SESSAO_DIAS=30

# Pasta web/ (templates e estáticos); vazio = ../web a partir do pacote. No container: /web
WEB_DIR=

# Pasta dos PDFs de edital subidos; vazio = data/uploads na raiz do repo. No container: /data/uploads
UPLOADS_DIR=

# Chave do Gemini (AI Studio free tier, ADR-0030); vazio = DNA gerado só por regras, sem LLM
GOOGLE_API_KEY=

# Modelo Gemini do agente analista-de-edital (ADR-0018: Flash para DNA; gemini-2.5-flash não
# aceita mais chaves novas — passo 12b da V3, https://ai.google.dev/gemini-api/docs/models)
MODELO_DNA=gemini-3.6-flash

# Teto diário de gasto com LLM em R$ (ADR-0018); atingido → cai para regras
TETO_DIARIO_BRL=3.00

# Pasta das provas coletadas (Cebraspe); vazio = knowledge/provas na raiz do repo, resolvida pela app
DOCUMENTOS_DIR=

# E-mail no User-Agent do coletor (ADR-0030), identificando as requisições à Cebraspe
CONTATO_COLETOR=vlfcandido@gmail.com

# Modelo Gemini do curador de questões (ADR-0018: Flash-Lite — cota diária é por modelo, passo
# 12b/12c; classificar num vocabulário fechado é "simple data processing", o Lite é o mais barato)
MODELO_CLASSIFICACAO=gemini-3.5-flash-lite

# Quantas questões o curador classifica por chamada ao LLM
LOTE_CLASSIFICACAO=20

# Modelo Gemini do agente `gerador-de-justificativa` (fundação jurídica, passo 5) — Flash, não
# Lite: explicar o gabarito ancorado em dispositivo é raciocínio, mesmo motivo de MODELO_DNA
MODELO_JUSTIFICATIVA=gemini-3.6-flash

# Banco descartável para os testes marcados `postgres` (vazio = esses testes são pulados)
# Crie uma vez: docker compose exec postgres createdb -U aprovaos aprovaos_teste
DATABASE_URL_TEST=
